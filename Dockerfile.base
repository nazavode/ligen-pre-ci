ARG GCC_VERSION=00

# ==========================================
# debian + gccXX (official image) 
# ==========================================

FROM gcc:${GCC_VERSION} AS debian

RUN apt-get update -y \
 && apt-get install -y --no-install-recommends \
      wget \
      tar \
      ninja-build \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# ==========================================
# RHEL 9 + gccXX (from official toolsets)
# ==========================================
FROM registry.access.redhat.com/ubi9/ubi AS rhel

ARG GCC_VERSION

RUN dnf -y update \
 && dnf install -y \
      wget \
      tar \
      ninja-build \
      gcc-toolset-${GCC_VERSION} \
      gcc-toolset-${GCC_VERSION}-libasan-devel  \
      gcc-toolset-${GCC_VERSION}-liblsan-devel  \
      gcc-toolset-${GCC_VERSION}-libtsan-devel  \
      gcc-toolset-${GCC_VERSION}-libubsan-devel \
 && dnf clean all

# Note: we don't want to deal with entrypoints, let's try to replicate
# environment changes usually applied by toolset activation scripts like:
# . /opt/rh/gcc-toolset-14/enable
# To look for modifications before and after the activation:
# $ docker run --rm -it myimage bash -c 'printenv; source /opt/rh/gcc-toolset-14/enable; echo "---"; printenv'
ENV PKG_CONFIG_PATH=/opt/rh/gcc-toolset-${GCC_VERSION}/root/usr/lib64/pkgconfig \
    MANPATH=/opt/rh/gcc-toolset-${GCC_VERSION}/root/usr/share/man \
    INFOPATH=/opt/rh/gcc-toolset-${GCC_VERSION}/root/usr/share/info \
    LD_LIBRARY_PATH=/opt/rh/gcc-toolset-${GCC_VERSION}/root/usr/lib64:/opt/rh/gcc-toolset-${GCC_VERSION}/root/usr/lib \
    PCP_DIR=/opt/rh/gcc-toolset-${GCC_VERSION}/root \
    PATH=/opt/rh/gcc-toolset-${GCC_VERSION}/root/usr/bin:${PATH}
